<%- messages() %>
    <% if (errors) { %>
        <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
        </ul>
<% } %>
<h1><%= vehicle.inv_year %> <%= vehicle.inv_make %> <%= vehicle.inv_model %></h1>
<section class="details">
    <img src="<%= vehicle.inv_image %>" alt="<%= vehicle.inv_make %>  <%= vehicle.inv_model %>">
    <div class="vehicle-data">
        <h2><%= vehicle.inv_make %> <%= vehicle.inv_model %> Details</h2>
        <p><strong>Price:</strong> <span class="v-info">$<%= Number(vehicle.inv_price).toLocaleString() %></span></p>
        <p><strong>Description: </strong><span class="v-info"><%= vehicle.inv_description %></span></p>
        <p><strong>Color: </strong><span class="v-info"><%= vehicle.inv_color %></span></p>
        <p><strong>Miles:</strong> <span class="v-info"><%= vehicle.inv_miles.toLocaleString() %></span></p>
    </div>
    <% if (locals.accountData) { %>
        <form class="wishlist_form" action="/wishlist/add" method="post"> 
                <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
                <input type="hidden" name="account_id" value="<%= locals.accountData.account_id %>">
                <div class="wrap">
                    <button type="submit" class="submitBtn">
                    Add to Wishlist
                    </button>
                </div>
        </form><!-- Show form only if logged in -->
    <% } else { %>
    <p><a class="button" href="/account/login">Log in</a> to add this vehicle to your wishlist.</p>
    <% } %>
    
</section>

